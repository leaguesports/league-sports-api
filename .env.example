# Local development
DATABASE_URL=postgresql://root:root1234@localhost:5432/league?schema=public
PORT=3000
NODE_ENV=development

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/providers/google/callback-url

JWT_SECRET=

# Integration tokens are encrypted at rest with a key derived from JWT_SECRET.
# Never log or return the raw token. API responses only include credentialMasked.

FRONTEND_URL=http://localhost:3001

# Optional extra CORS origins (comma-separated)
# CORS_ORIGINS=http://127.0.0.1:3001

# ---------------------------------------------------------------------------
# Railway production (set in Railway dashboard — do not commit secrets)
# ---------------------------------------------------------------------------
# NODE_ENV=production
# FRONTEND_URL=https://leaguesports.co.za
#
# OAuth callback must go through the frontend (Vercel proxies /api/* to Railway)
# so the auth cookie is set on leaguesports.co.za (first-party).
# GOOGLE_REDIRECT_URI=https://leaguesports.co.za/api/auth/providers/google/callback-url
#
# Frontend (Next.js on Vercel):
# NEXT_PUBLIC_API_URL=https://league-sports-api-production.up.railway.app
# NEXT_PUBLIC_SITE_URL=https://leaguesports.co.za
#
# Google Cloud Console → Authorized redirect URIs must include:
# https://leaguesports.co.za/api/auth/providers/google/callback-url
