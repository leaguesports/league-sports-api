// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  profile        Profile?
  accounts       Account[]
}

model Account {
  id           String   @id @default(uuid())
  userId       String
  provider     String
  providerId   String
  accessToken  String
  refreshToken String
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@index([userId])
}

model Profile {
  id        String  @id @default(uuid())
  userId    String  @unique
  firstName String
  lastName  String
  email     String  @unique @default("")
  handle    String  @unique
  avatarUrl String?

  user User @relation(fields: [userId], references: [id])
}

model Venue {
  id      String        @id @default(uuid())
  cmsId   String        @unique
  name    String
  slug    String
  matches Match[]
  follows VenueFollow[]
}

model VenueFollow {
  id         String   @id @default(uuid())
  userId     String
  venueCmsId String
  createdAt  DateTime @default(now())

  venue Venue @relation(fields: [venueCmsId], references: [cmsId], onDelete: Cascade)

  @@unique([userId, venueCmsId])
  @@index([userId])
  @@index([venueCmsId])
}

enum MatchRuleset {
  golden_point
  advantage
}

enum MatchStatus {
  live
  locked
}

enum MatchTeam {
  A
  B
}

enum MatchPlayerSlot {
  A1
  A2
  B1
  B2
}

model Match {
  id          String        @id @default(uuid())
  venueCmsId  String
  venue       Venue         @relation(fields: [venueCmsId], references: [cmsId])
  startsAt    DateTime
  ruleset     MatchRuleset
  status      MatchStatus   @default(live)
  servingTeam MatchTeam?
  winnerTeam  MatchTeam?
  lockedAt    DateTime?
  score       Json?
  createdAt   DateTime      @default(now())
  players     MatchPlayer[]

  @@index([venueCmsId])
  @@index([status, startsAt])
}

model MatchPlayer {
  id          String          @id @default(uuid())
  matchId     String
  match       Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  slot        MatchPlayerSlot
  userId      String?
  displayName String
  isGuest     Boolean

  @@unique([matchId, slot])
  @@index([userId])
}
