// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  WATCH @map("watch")
  PLAY  @map("play")
}

model User {
  id String @id @default(uuid())

  profile        Profile?
  accounts       Account[]
  favouritVenues FavouritVenues[]
}

model Account {
  id           String   @id @default(uuid())
  userId       String
  provider     String
  providerId   String
  accessToken  String
  refreshToken String
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@index([userId])
}

model Profile {
  id        String @id @default(uuid())
  userId    String @unique
  firstName String
  lastName  String
  email     String @unique @default("")

  user User @relation(fields: [userId], references: [id])
}

model WaitList {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  data      Json
  createdAt DateTime @default(now())
}

model Venue {
  id    String @id @default(uuid())
  cmsId String @unique
  name  String

  favouritesCount Int @default(0)

  favourites FavouritVenues[]

  @@index([cmsId])
}

model FavouritVenues {
  id      String @id @default(uuid())
  userId  String
  venueId String

  user  User  @relation(fields: [userId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])

  @@unique([userId, venueId])
  @@index([userId])
  @@index([venueId])
}
